{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/decor/**",
              "figma/setup-plugin/**",
              "ui_kits/brand-canvas/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Optima nova LT Pro|Optima nova LT Pro Cond|Wix Madefor Text|Seaweed Script|Inter))/i]",
        "message": "Font not provided by the design system. Available: Optima nova LT Pro, Optima nova LT Pro Cond, Wix Madefor Text, Seaweed Script, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|fill|ring|key|ref|className|style|children)$/]",
        "message": "<AccentCircle> doesn't accept that prop. Declared props: size, fill, ring."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|as|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, as, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|accent)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg|card)$/]",
        "message": "<Button> size must be one of 'md' | 'lg' | 'card'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|width|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: tone, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Divider> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<FeatureItem> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|as|children|key|ref|className|style|children)$/]",
        "message": "<Kicker> doesn't accept that prop. Declared props: tone, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:label|plan|dark|hero)$/]",
        "message": "<Kicker> tone must be one of 'label' | 'plan' | 'dark' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlanCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:plan|price|cadence|features|cta|image|onCta|key|ref|className|style|children)$/]",
        "message": "<PlanCard> doesn't accept that prop. Declared props: plan, price, cadence, features, cta, image, onCta."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScriptAccent'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|rotate|tone|children|key|ref|className|style|children)$/]",
        "message": "<ScriptAccent> doesn't accept that prop. Declared props: size, rotate, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScriptAccent'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|olive|dark)$/]",
        "message": "<ScriptAccent> tone must be one of 'primary' | 'olive' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SketchRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|variant|tone|basePath|key|ref|className|style|children)$/]",
        "message": "<SketchRing> doesn't accept that prop. Declared props: width, variant, tone, basePath."
      },
      {
        "selector": "JSXOpeningElement[name.name='SketchRing'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:a|b)$/]",
        "message": "<SketchRing> variant must be one of 'a' | 'b'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SketchRing'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:salmon|slate|green)$/]",
        "message": "<SketchRing> tone must be one of 'salmon' | 'slate' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|arrow|children|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: tone, arrow, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<TextLink> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TexturePanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:basePath|children|key|ref|className|style|children)$/]",
        "message": "<TexturePanel> doesn't accept that prop. Declared props: basePath, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnderlineSwoosh'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|tone|basePath|key|ref|className|style|children)$/]",
        "message": "<UnderlineSwoosh> doesn't accept that prop. Declared props: width, tone, basePath."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnderlineSwoosh'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|sienna|green)$/]",
        "message": "<UnderlineSwoosh> tone must be one of 'gold' | 'sienna' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|tone|plate|basePath|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: width, tone, plate, basePath."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|green|ink)$/]",
        "message": "<Wordmark> tone must be one of 'cream' | 'green' | 'ink'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
